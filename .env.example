# Copy to .env.local and fill in. Every value here is safe to expose to the
# browser (they're all NEXT_PUBLIC_*) — the anon key is protected by row-level
# security, not by secrecy. See DEPLOY.md for where to find each one.

# The origin the site is served from. Used for canonical URLs, the sitemap,
# Open Graph tags and auth email links. Must match the host you actually
# serve — if the apex redirects to www, put the www form here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API. Leave both blank to run the site on
# static seed content, with /admin, /contact and /scripts disabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics. Optional — both only load in production, and only after the
# visitor accepts the cookie banner. Leaving these unset falls back to the
# production property IDs in src/lib/site.ts; set them to override.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# ── Status page (status.blobbyofficial.com) ──────────────────────────────
# Server-only, NOT NEXT_PUBLIC_: the cron route at /api/status/check writes
# check history and service states, which row-level security forbids for
# every visitor-facing key. Supabase → Project Settings → API → service_role.
# Leave blank and /status still renders — it just has no fresh checks.
SUPABASE_SERVICE_ROLE_KEY=

# Set automatically by Vercel Cron. When present, /api/status/check requires
# it as a bearer token so nobody else can trigger the pings.
CRON_SECRET=

# Salt for the per-reporter hash behind the "report an outage" button. Any
# long random string; changing it just resets who counts as a repeat reporter.
STATUS_REPORT_SALT=
